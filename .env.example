# ==========================================
# ZenixMind AI Provider
# ==========================================

# GroqCloud — used by the production chat and streaming endpoints.
# Keep this server-side only. Never prefix it with VITE_ or NEXT_PUBLIC_.
GROQ_API_KEY="your-groq-api-key"

# Supabase Auth and database (optional local development values)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only Supabase service role key used by the scheduled task worker.
# Never prefix this with VITE_ and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Tavily Search + Deep Research. Keep this server-side only (never use a VITE_ prefix).
# Create a key at https://app.tavily.com/home
TAVILY_API_KEY="your-tavily-api-key"

# Pollinations image generation. Keep this server-side only (never use a VITE_ prefix).
# Create a key at https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY="your-pollinations-secret-key"

# GitHub OAuth App for the optional read-only Connected tools integration.
# Callback URL: https://zenixmind.vercel.app/api/connected-tools/callback
GITHUB_OAUTH_CLIENT_ID="your-github-oauth-client-id"
GITHUB_OAUTH_CLIENT_SECRET="your-github-oauth-client-secret"

# Random secret of at least 32 characters for AES-256-GCM encrypted provider tokens.
# Keep server-only; never use a VITE_ or NEXT_PUBLIC_ prefix.
INTEGRATION_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-secret-of-at-least-32-characters"
