{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/status", "destination": "/api/status" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/broadcasts/active", "destination": "/api/broadcasts/active" },
    { "source": "/api/session/heartbeat", "destination": "/api/session/heartbeat" },
    { "source": "/api/admin/activity-analytics", "destination": "/api/admin/activity-analytics" },
    { "source": "/api/admin/sessions", "destination": "/api/admin/sessions" },
    { "source": "/api/admin/overview", "destination": "/api/admin/overview" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
